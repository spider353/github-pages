<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Al Jannah Perfumes</title>
  <link rel="stylesheet" href="style.css">
</head>
<body>
  <h1>Al Jannah Perfumes</h1>
  <p>UNIQUE FRAGRANCES TO HIGHLIGHT YOUR STYLE.</p>
  <button onclick="sayHello()">Click Me</button>

  <script src="script.js"></script>
</body>
</html>
body {
  font-family: Arial, sans-serif;
  background-color: #f0f0f0;
  text-align: center;
  padding: 50px;
}

h1 {
  color: #333;
}

p {
  font-size: 18px;
  color: #666;
}

button {
  padding: 10px 20px;
  font-size: 16px;
  background-color: #4CAF50;
  color: white;
  border: none;
  border-radius: 5px;
  cursor: pointer;
}

button:hover {
  background-color: #45a049;
}
function sayHello() {
  alert("Buy now your fragrance");
}
